# Copia questo file in .env.local e compila i valori.
# In locale i valori di URL e chiavi sono quelli stampati da `supabase start`.
# Non incollare mai valori reali in chat: se succede, ruota la chiave.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Su Vercel, se non accetta il prefisso NEXT_PUBLIC_ su una variabile segreta,
# usa gli stessi valori con SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY e APP_URL
# (next.config.ts li passa al browser al momento della build).

# Solo server. Mai prefisso NEXT_PUBLIC_, mai importata da un file 'use client'.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protegge /api/cron/keep-alive. Genera con: openssl rand -hex 32
CRON_SECRET=

# "true" solo in locale (serve a Playwright e agli screenshot). Mai su Vercel.
ENABLE_DEV_LOGIN=true
