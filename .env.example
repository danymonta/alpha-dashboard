# Copia questo file in .env.local e compila i valori.
# In locale i valori di URL e chiavi sono quelli stampati da `supabase start`.
# Non incollare mai valori reali in chat: se succede, ruota la chiave.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Su Vercel, se non accetta il prefisso NEXT_PUBLIC_ su una variabile segreta,
# usa gli stessi valori con SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY e APP_URL
# (next.config.ts li passa al browser al momento della build).

# Solo server. Mai prefisso NEXT_PUBLIC_, mai importata da un file 'use client'.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protegge /api/cron/keep-alive. Genera con: openssl rand -hex 32
CRON_SECRET=

# "true" solo in locale (serve a Playwright e agli screenshot). Mai su Vercel.
ENABLE_DEV_LOGIN=true

# Email di invito via Resend (resend.com). Solo server. Se vuota, l'invito si
# salva lo stesso e l'app mostra il link da copiare.
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend, es. "Percorso Alpha <team@tuodominio.it>"
EMAIL_MITTENTE=

# Alfire, l'assistente AI. Chiave gratuita da console.groq.com > API Keys.
# Solo server, mai NEXT_PUBLIC_. Se vuota, Alfire resta spenta e lo dice.
ALFIRE_API_KEY=
# Facoltative: altro fornitore OpenAI-compatibile o altro modello
# ALFIRE_BASE_URL=https://api.groq.com/openai/v1
# ALFIRE_MODEL=openai/gpt-oss-120b
# ALFIRE_MODEL_VOCE=whisper-large-v3-turbo
# Legge foto e scansioni allegate (il modello della chat legge solo testo).
# Vuota = qwen/qwen3.8-27b su Groq; "off" spegne la lettura delle immagini.
# ALFIRE_MODEL_VISIONE=qwen/qwen3.8-27b
# Piano Groq: vuota = lo dice Groq a ogni risposta (8K token al minuto = gratuito,
# 250K = Developer: Alfire lavora da agente con tutti gli strumenti sempre).
# "developer" o "gratuito" lo forzano.
# ALFIRE_PIANO=

# "Scegli da Drive" nella scheda del cliente (Google Picker). Tre valori pubblici,
# non segreti: il browser li riceve. Vuoti = niente bottone, resta il link da incollare.
# Valgono anche con il prefisso NEXT_PUBLIC_ (NEXT_PUBLIC_GOOGLE_CLIENT_ID, …).
# Client OAuth "Applicazione web" (lo stesso del login Google o uno nuovo)
GOOGLE_CLIENT_ID=
# Chiave API (pubblica: arriva nel browser) limitata ai siti dell'app e a
# https://docs.google.com/* (il Picker gira lì), e a Google Picker API e Google Drive API
GOOGLE_PICKER_API_KEY=
# Numero del progetto Google Cloud (solo cifre), dalla home della Cloud Console
GOOGLE_APP_ID=
